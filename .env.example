# ===== จำเป็น (production) =====
SESSION_SECRET=            # สุ่มยาว >= 32 ตัวอักษร (ไม่ตั้ง = เว็บตอบ 503 ไม่ทำงานด้วยกุญแจที่เดาได้)
ADMIN_DISCORD_IDS=         # Discord ID ของแอดมิน คั่นด้วย ,
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=      # https://flexozy.xyz/api/auth/discord/callback
KV_REST_API_URL=           # Vercel KV - ข้อมูลถาวร + rate limit ข้าม instance
KV_REST_API_TOKEN=

# ===== โดเมน =====
API_HOST=api.flexozy.xyz               # โดเมน API หลัก (executor)
API_FALLBACK_HOSTS=                    # โดเมนสำรองเมื่อ Cloudflare บล็อก เช่น flexozy-api.vercel.app (คั่นด้วย ,)
WEB_HOST=flexozy.xyz

# ===== ไม่บังคับ =====
NEXT_PUBLIC_TURNSTILE_SITE_KEY=        # Turnstile (ถูกบล็อก/ไม่ตั้ง = ใช้ proof-of-work แทน)
TURNSTILE_SECRET_KEY=
TURNSTILE_STRICT=0                     # 1 = บังคับ Turnstile อย่างเดียว ไม่มีทางสำรอง
REQUIRE_KEY_HUB=1                      # ค่าเริ่มต้นเปิด (ต้องมี key + ซ่อน URL สคริปต์) - 0 = โหมดเปิด
SCRIPT_HOST_ALLOW=raw.githubusercontent.com,gist.githubusercontent.com
DISCORD_INVITE=WFUejxeggt              # โค้ดเชิญ Discord ที่โชว์ใน Hub
KEY_LINK=                              # ลิงก์ปุ่ม Get Key (ว่าง = ใช้ลิงก์ Discord)

ANTI_DUMP_STRICT=1                     # 1 = เตะคนที่ loadstring/HttpGet ถูกฮุก (ค่าเริ่มต้น) | 0 = ปิดเฉพาะเช็กฮุก (ถ้า executor บางตัวโดนเตะผิด)

# ===== v10: ป้องกัน dump /loader (ค่าเริ่มต้นเปิดทั้งหมด) =====
ANTI_DUMP_SEAL=1                       # 1 = ซีล /loader (print(HttpGet) ไม่เห็นโดเมน/token) | 0 = ปิด
BOOT_BIND_IP=1                         # 1 = token ของ /bootstrap-source ผูก IP ผู้ขอ | 0 = ไม่ผูก (ถ้าผู้ใช้เครือข่ายมือถือ IP เปลี่ยนกลางทางแล้วโหลดไม่ผ่าน)
LOADER_DEBT_MAX=10                     # ดึง /loader เกินที่ใช้ token กี่ครั้งใน 10 นาที ถึงถูกแบน
LOADER_BAN_SEC=900                     # แบนกี่วินาที

